# Local Postgres (pgvector). See README for Docker / Vercel Postgres / Neon.
DATABASE_URL="postgresql://ideadaily:ideadaily@localhost:5432/ideadaily"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# sample | live | auto (auto is sample until an LLM key AND DataForSEO are set)
IDEADAILY_DATA_MODE="auto"

# LLM — set one provider. If none are set, reports, guides polish, and the
# advisor use the built-in template writer and show a Sample data badge.
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
GEMINI_MODEL="gemini-2.0-flash"

# Signal harvest. Every adapter is optional. Missing keys use labelled sample signals.
# Hacker News Algolia and Apple RSS need no key; they are skipped to sample data if the request fails.
PRODUCTHUNT_TOKEN=""
YOUTUBE_API_KEY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
# Alphabet Demand. Live Google Autocomplete via DataForSEO when the login above is set.
# One live call is one keyword. A full mine is 40 calls (a-z, 0-9, how/why/best/can).
# How many admin seed niches to mine each night. Default 3. Each niche queues up to 2 ideas.
AUTOCOMPLETE_SEEDS_PER_NIGHT="3"
# Unofficial Google suggest endpoint. Leave unset. Setting this to true may conflict with
# Google's terms. DataForSEO is used instead whenever its credentials exist.
ALLOW_UNOFFICIAL_AUTOCOMPLETE="false"
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""
EXA_API_KEY=""

# Stripe. If STRIPE_SECRET_KEY is empty, pricing uses a labelled demo upgrade (no charge).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_BUILDER_MONTHLY=""
STRIPE_PRICE_BUILDER_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""

# Resend. If empty, publish writes the email HTML to the pipeline log instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="IdeaDaily <ideas@example.com>"

# Inngest. If empty, run jobs from /admin or the Vercel cron routes.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Vercel Cron hits /api/cron/* with Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
